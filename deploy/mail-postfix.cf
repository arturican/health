# Health Diary: outbound application mail only. DNS verified in T187.
compatibility_level = 3.6
myhostname = mail.arturican.com
myorigin = auth.arturican.com
mydestination =
relayhost =
relay_domains =
inet_interfaces = 127.0.0.1
inet_protocols = ipv4
mynetworks = 127.0.0.1/32
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_sender_restrictions = check_sender_access regexp:/etc/postfix/health-senders
smtpd_recipient_limit = 1
smtpd_client_message_rate_limit = 30
smtpd_client_event_limit_exceptions =
disable_vrfy_command = yes
message_size_limit = 131072
smtp_tls_security_level = verify
smtp_tls_verify_cert_match = hostname
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 0
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6
default_process_limit = 10
smtp_destination_concurrency_limit = 2
minimal_backoff_time = 60s
maximal_backoff_time = 300s
queue_run_delay = 60s
maximal_queue_lifetime = 10m
bounce_queue_lifetime = 10m
defer_transports =
