[Unit]
Description=Encrypted Health Diary backup and offsite transfer
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /usr/local/libexec/backup_send.py
User=root
UMask=0077
TimeoutStartSec=1250
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/health-diary /var/lib/health-backup
