[Unit]
Description=Health Diary backup check and email notification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/backup_monitor.py --config /etc/health-diary/backup-monitor.json --send
TimeoutStartSec=60
UMask=0077
StateDirectory=health-backup-monitor
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
