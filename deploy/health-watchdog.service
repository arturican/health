[Unit]
Description=Independent Health Diary API watchdog
After=network-online.target health-api-tunnel.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/watchdog_monitor.py --config /etc/health-diary/watchdog.json --send
TimeoutStartSec=60
UMask=0077
StateDirectory=health-watchdog
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
