# Optional machine-only overrides. Copy to .env.local before local:setup.
# Not encrypted/shared; missing values use these defaults. Do not put secrets here.
# Free loopback ports chosen by you (1024..65535; all three must differ).
DEV_DB_PORT=55433
DEV_API_PORT=3001
DEV_UI_PORT=5173
# Docker name you choose, starts with health-dev-; volume is <name>-data.
# Use a different name for a second checkout; never point at production services.
DEV_CONTAINER=health-dev-local
