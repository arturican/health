{
  "name": "health-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.0 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "db:seed": "npm run build:api && node --env-file-if-exists=.env build-api/seedDemo.js",
    "account:create": "npm run build:api && node build-api/createAccount.js",
    "db:migrate": "npm run build:api && node --env-file-if-exists=.env build-api/migrate.js",
    "build:api": "tsc -p tsconfig.server.json && vite build --config vite.server.config.ts",
    "start:api": "node --env-file-if-exists=.env build-api/main.js",
    "dev:api": "npm run build:api && npm run start:api",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "check:docs": "node --test scripts/check-docs.test.mjs scripts/check-mermaid.test.mjs && node scripts/check-docs.mjs && node scripts/check-mermaid.mjs",
    "check": "npm run check:docs && npm run lint && npm run typecheck && npm run test:coverage && npm run test:browser:run && npm run build && npm run test:e2e",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest --config vitest.browser.config.ts --ui",
    "test:browser:run": "vitest run --config vitest.browser.config.ts --browser.headless",
    "test:e2e:ui": "playwright test --ui",
    "test:design": "playwright test design-",
    "test:design:ui": "playwright test design- --ui"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "1.1.7",
    "fastify": "5.12.7",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "mermaid": "12.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "vitest-browser-react": "2.3.0"
  }
}
