# Shared DEVELOPMENT secrets only. Never copy production api.env/admin.env here.
# Required by setup; obtain automatically over SSH from the development VPS helper.
# Created once by secrets:init; setup never resets values. Examples are placeholders.
# Password alphabet: A-Z/a-z/0-9/_/-, at least 15 characters.
# Local cluster administrator: provisioning + isolated health_test only.
DEV_POSTGRES_PASSWORD=REPLACE_WITH_ENCRYPTED_VALUE
# Limited API role health_app, no schema ownership.
DEV_APP_PASSWORD=REPLACE_WITH_ENCRYPTED_VALUE
# Schema owner health_migrator, migrations/seed only.
DEV_MIGRATOR_PASSWORD=REPLACE_WITH_ENCRYPTED_VALUE
# Synthetic local-demo account; used only on initial account creation.
DEV_DEMO_PASSWORD=REPLACE_WITH_ENCRYPTED_VALUE
# Optional machine settings: .env.local.example -> .env.local; never encrypt them.
# Direct server commands still accept DATABASE_URL/MIGRATION_DATABASE_URL,
# APP_ORIGIN, API_HOST/PORT, NODE_ENV, MAIL_ENABLED/MAIL_SMTP_PORT, API_TRUST_PROXY
# and ADMIN_LOGIN/PASSWORD/TIMEZONE; see README/DEPLOYMENT. No VITE_* secrets.
