# Server only. Copy to a private file (chmod 600); never use VITE_ for secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Optional service mail on the SAME VPS as API/Postfix. Disabled by default.
# No remote SMTP host, login or password; never use VITE_ variables here.
MAIL_ENABLED=false
MAIL_SMTP_PORT=25
# Required with DATABASE_URL; production accepts HTTPS origins only (no trailing /).
APP_ORIGIN=http://127.0.0.1:5173
# Production: APP_ORIGIN=https://dev.arturican.com, API_PORT=3101
# VPS runtime file: /etc/health-diary/api.env (root 600); admin.env is separate.
# Frontend same-origin /api -> private SSH tunnel -> API; no public DB port.
# Vite proxy defaults to loopback 3001; optionally export HEALTH_API_PROXY in shell.
# Configure these only in a private server file. Migration and runtime roles differ.
# MIGRATION_DATABASE_URL=postgresql://health_migrator:REPLACE@127.0.0.1:6767/health
# DATABASE_URL=postgresql://health_app:REPLACE@127.0.0.1:6767/health
# Tests require a separate local database named health_test, never the working DB.
# TEST_DATABASE_URL=postgresql://postgres:synthetic-local-only@127.0.0.1:55432/health_test
# Account creation only: put these and MIGRATION_DATABASE_URL in a separate
# chmod-600 admin env file, never in the production API service environment.
# ADMIN_LOGIN=demo
# ADMIN_TIMEZONE=Europe/Moscow
# ADMIN_PASSWORD=
# Encrypted PostgreSQL backup: deploy/backup.example.json and docs/BACKUPS.md.
# Do not add backup private keys or admin credentials to the API environment.
